{%- comment -%}
PIPELINE — "BASIS OF LIVING EARTH" interactive stage diagram.
Hover a stage to see its description; click to go to that section of the site.
Data lives in _data/pipeline.yml (icon keyword, label, detail, url).
A stage left with a blank url just shows its detail on click instead of navigating.
{%- endcomment -%}
<section class="pipeline-section">
  <div class="container">
    <div class="pipeline-card">
      <div class="pipeline-head">
        <span class="pipeline-eyebrow">BASIS OF LIVING EARTH</span>
        <h2 class="pipeline-title">Taking Earth Observation to Users</h2>
      </div>

      <div class="pipeline-infra">Digital infrastructure (based on the Open Data Cube)</div>

      <div class="pipeline-flow">
        {% for stage in site.data.pipeline %}
          <a class="pipeline-stage"
             href="{{ stage.url | default: '#' }}"
             data-label="{{ stage.label | escape }}"
             data-detail="{{ stage.detail | escape }}"
             {% unless stage.url %}data-nolink="true"{% endunless %}>
            <span class="pipeline-stage-inner">
              <svg class="pipeline-icon" viewBox="0 0 24 24"><use href="#{{ stage.icon }}"/></svg>
              <span class="pipeline-num">{% if forloop.index < 10 %}0{{ forloop.index }}{% else %}{{ forloop.index }}{% endif %}</span>
              <span class="pipeline-label">{{ stage.label }}</span>
            </span>
          </a>
        {% endfor %}
      </div>

      <div class="pipeline-detail placeholder" id="pipelineDetail">Hover a stage above to see what happens at that step, CLICK to go there.</div>

      <div class="pipeline-calib">
        <div class="pipeline-calib-strip"><span></span><span></span><span></span><span></span></div>
        <span class="pipeline-calib-label">Calibration and Validation</span>
      </div>

      <div class="pipeline-engage">
        Engagement <span> e.g. academia, governments, research and space agencies, NGOs, landholders</span>
      </div>
    </div>
  </div>
</section>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <g id="ic-data"><circle cx="12" cy="12" r="9" fill="none" stroke="#fff" stroke-width="1.6"/><path d="M12 7v5l3 2" stroke="#fff" stroke-width="1.6" fill="none"/></g>
    <g id="ic-leaf"><path d="M5 19c8 0 14-6 14-14C11 5 5 11 5 19Z" fill="none" stroke="#fff" stroke-width="1.6"/></g>
    <g id="ic-map"><path d="M4 6l6-2 6 2 4-2v14l-4 2-6-2-6 2V6Z" fill="none" stroke="#fff" stroke-width="1.6"/></g>
    <g id="ic-change"><path d="M4 12a8 8 0 0 1 14-5M20 4v4h-4M20 12a8 8 0 0 1-14 5M4 20v-4h4" fill="none" stroke="#fff" stroke-width="1.6"/></g>
    <g id="ic-future"><path d="M12 3v4M12 17v4M3 12h4M17 12h4" stroke="#fff" stroke-width="1.6"/><circle cx="12" cy="12" r="4" fill="none" stroke="#fff" stroke-width="1.6"/></g>
    <g id="ic-deliver"><path d="M3 12l8-8 8 8-8 8-8-8Z" fill="none" stroke="#fff" stroke-width="1.6"/></g>
  </defs>
</svg>

<script>
  (function () {
    var stages = document.querySelectorAll('.pipeline-stage');
    var detailBox = document.getElementById('pipelineDetail');

    stages.forEach(function (el) {
      var show = function () {
        detailBox.classList.remove('placeholder');
        detailBox.innerHTML = '<span class="pipeline-dot"></span><strong>' + el.dataset.label + ':</strong>&nbsp;' + el.dataset.detail;
      };
      el.addEventListener('mouseenter', show);
      el.addEventListener('focus', show);
      el.addEventListener('click', function (e) {
        if (el.dataset.nolink === 'true') {
          e.preventDefault();
          show();
        }
      });
    });
  })();
</script>
