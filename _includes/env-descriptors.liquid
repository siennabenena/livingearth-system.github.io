{%- comment -%}
ENVIRONMENTAL DESCRIPTORS BROWSER — three-level click-to-expand accordion.
Level 1: top category (e.g. Marine, Land and Water, Atmosphere)
Level 2: optional subcategory (e.g. Vegetation, Soil) — Marine has none,
         so its descriptors sit directly under Level 1
Level 3: individual descriptor — photo + short definition, not a link

Usage: {% include env-descriptors.liquid list=page.env_descriptors %}

Data shape — each top-level category needs: title, image, and EITHER:
  descriptors    — a flat list of { title, image, description } shown
                   directly when this category is clicked (e.g. Marine)
  subcategories  — a list of { title, image, descriptors: [...] } shown
                   when this category is clicked, each of which expands
                   its own descriptors list when clicked (e.g. Land and Water)
{%- endcomment -%}
{% assign categories = include.list %}
{%- if categories -%}
<section class="env-desc">
  <div class="container">

    <div class="env-desc-row">
      {% for cat in categories %}
        <button class="env-desc-cat" type="button" data-cat="{{ forloop.index0 }}" aria-expanded="false">
          <img src="{{ cat.image | relative_url }}" alt="" class="env-desc-cat-img">
          <span class="env-desc-cat-title">{{ cat.title }}</span>
        </button>
      {% endfor %}
    </div>

    {% for cat in categories %}
      <div class="env-desc-panel" data-cat-panel="{{ forloop.index0 }}" hidden>

        {% if cat.subcategories %}
          <div class="env-desc-subrow">
            {% for sub in cat.subcategories %}
              <button class="env-desc-sub" type="button" data-sub="{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}" aria-expanded="false">
                <img src="{{ sub.image | relative_url }}" alt="" class="env-desc-sub-img">
                <span class="env-desc-sub-title">{{ sub.title }}</span>
              </button>
            {% endfor %}
          </div>

          {% for sub in cat.subcategories %}
            <div class="env-desc-items-grid" data-sub-panel="{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}" hidden>
              {% for item in sub.descriptors %}
                <div class="env-desc-item">
                  <img src="{{ item.image | relative_url }}" alt="" class="env-desc-item-img">
                  <span class="env-desc-item-title">{{ item.title }}</span>
                  <span class="env-desc-item-desc">{{ item.description }}</span>
                </div>
              {% endfor %}
            </div>
          {% endfor %}

        {% elsif cat.descriptors %}
          <div class="env-desc-items-grid">
            {% for item in cat.descriptors %}
              <div class="env-desc-item">
                <img src="{{ item.image | relative_url }}" alt="" class="env-desc-item-img">
                <span class="env-desc-item-title">{{ item.title }}</span>
                <span class="env-desc-item-desc">{{ item.description }}</span>
              </div>
            {% endfor %}
          </div>
        {% endif %}

      </div>
    {% endfor %}

  </div>
</section>

<script>
(function() {
  var catButtons = document.querySelectorAll('.env-desc-cat[data-cat]');
  var catPanels = document.querySelectorAll('.env-desc-panel[data-cat-panel]');

  catButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = btn.getAttribute('data-cat');
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      catButtons.forEach(function(b) { b.setAttribute('aria-expanded', 'false'); b.classList.remove('is-active'); });
      catPanels.forEach(function(p) { p.hidden = true; });
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('is-active');
        var panel = document.querySelector('.env-desc-panel[data-cat-panel="' + id + '"]');
        if (panel) { panel.hidden = false; }
      }
    });
  });

  var subButtons = document.querySelectorAll('.env-desc-sub[data-sub]');
  subButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = btn.getAttribute('data-sub');
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      var parentPanel = btn.closest('.env-desc-panel');
      parentPanel.querySelectorAll('.env-desc-sub').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); b.classList.remove('is-active'); });
      parentPanel.querySelectorAll('.env-desc-items-grid[data-sub-panel]').forEach(function(p) { p.hidden = true; });
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('is-active');
        var grid = parentPanel.querySelector('.env-desc-items-grid[data-sub-panel="' + id + '"]');
        if (grid) { grid.hidden = false; }
      }
    });
  });
})();
</script>
{%- endif -%}
